# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" NÃO vai para o Git.
# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, só o chat fica desativado.
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Porta local (opcional). Padrão: 3000
PORT=3000
